<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.team.ecobuilders.myestList.dao.IMyestListDAO">

    <!-- 나의견적서 목록 조회 -->
    <select id="getEstList" resultType="com.team.ecobuilders.myestList.dto.MyestListDTO">
        SELECT 
            EST_ID,  <!-- EST_ID를 직접 사용 -->
        FROM est
    </select>

    <!-- 나의견적서 ID로 조회 -->
    <select id="getEstListById" parameterType="String" resultType="com.team.ecobuilders.myestList.dto.MyestListDTO">
        SELECT 
            EST_ID,  <!-- EST_ID를 직접 사용 -->
        FROM est 
        WHERE EST_ID = #{estId}  <!-- estId로 직접 비교 -->
    </select>

</mapper>